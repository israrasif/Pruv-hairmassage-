{
  "expo": {
    "name": "Growmo",
    "slug": "growmo",
    "scheme": "growmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growmo.app"
    },
    "android": {
      "package": "com.growmo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF8F5"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Growmo uses your camera so you can take hair progress photos for your private Vault.",
          "photosPermission": "Growmo accesses your photos so you can import hair progress photos into your private Vault.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
